PORT=3000
# postgres (por defecto) o sqlite (para probar sin servidor)
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reviewlab
DB_USER=postgres
DB_PASSWORD=password
# solo si DB_DIALECT=sqlite
DB_STORAGE=./reviewlab.sqlite
# false = no recrear tablas en cada arranque
DB_FORCE_SYNC=true
